# Server
HOST=0.0.0.0
PORT=8080

# Optional: shared secret so only your website can call this webhook
WEBHOOK_SECRET=

# Default region if phone has no country code (e.g. PK, US, AE)
DEFAULT_PHONE_REGION=PK

# Google Sheets (service account JSON path + spreadsheet)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json
# On Railway: paste the full JSON key as one line (preferred)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET=Leads

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Approved template name + language (e.g. en, en_US)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# true if template body uses {{1}} for name; false if template has no variables
WHATSAPP_TEMPLATE_HAS_NAME_PARAM=true