# Server
HOST=0.0.0.0
PORT=8080

# Optional: shared secret so only your website can call this webhook
WEBHOOK_SECRET=

# Default region if phone has no country code (e.g. PK, US, AE)
DEFAULT_PHONE_REGION=PK

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json
# On Railway: paste the full JSON key as one line
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET=Leads

# Intake form base (used if website does not send intake_url)
INTAKE_BASE_URL=https://the-syndicate.com

# Whapi.Cloud
WHAPI_TOKEN=
WHAPI_API_URL=https://gate.whapi.cloud
# true = send intake link first (rich preview card), then message text without raw URL
WHAPI_LINK_SEPARATE=true
# Message body only — do NOT put {intake_url} here when WHAPI_LINK_SEPARATE=true
WHAPI_MESSAGE_TEXT=Hi {name},\n\nJust complete the quick form and we will schedule the exclusive audit with our founder for some time this week\n\nSee you on the inside\n\nWith Honour\nThe Syndicate
