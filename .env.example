# Server
HOST=0.0.0.0
PORT=8080

# Optional: shared secret so only your website can call this webhook
WEBHOOK_SECRET=

# Default region if phone has no country code (e.g. PK, US, AE)
DEFAULT_PHONE_REGION=PK

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json
# On Railway: paste the full JSON key as one line
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET=Leads

# Intake form base (used if website does not send intake_url)
INTAKE_BASE_URL=https://the-syndicate.com

# Whapi.Cloud
WHAPI_TOKEN=
WHAPI_API_URL=https://gate.whapi.cloud
# Placeholders: {name} {email} {intake_url}
WHAPI_MESSAGE_TEXT=Hi {name}, your Syn Diagnosis follow-up is ready.\nOpen your form here: {intake_url}
# true = send URL first (preview), then text
WHAPI_LINK_SEPARATE=true

# Audit booking confirmation (from website BOOKING_WEBHOOK_URL → /webhook/booking)
# Placeholders: {name} {email} {meet_link} {slot_local} {timezone}
WHAPI_BOOKING_MESSAGE_TEXT=Hi {name},\n\nYour founder audit is booked.\n\nTime: {slot_local}\nJoin with Google Meet:\n{meet_link}\n\nWith Honour\nThe Syndicate
WHAPI_BOOKING_REMINDER_TEXT=Hi {name},\n\nReminder: your founder audit starts soon.\n\nTime: {slot_local}\nJoin here:\n{meet_link}\n\nWith Honour\nThe Syndicate
BOOKING_REMINDER_MINUTES_BEFORE=60
GOOGLE_SHEET_BOOKINGS_WORKSHEET=Bookings

# Optional: protect /cron/reminders (Railway cron every 10 min)
CRON_SECRET=

# Sub-agent A — add leads to WhatsApp group after successful WA message
# Fetch ID: GET https://gate.whapi.cloud/groups  (or GET /admin/groups on this bot)
WHAPI_GROUP_ID=
# true/false — set false to pause group adds without removing the ID
WHAPI_GROUP_ADD_ENABLED=true
# Optional fallback if WhatsApp blocks direct add
WA_GROUP_INVITE_URL=
WA_CHANNEL_INVITE_URL=
# Placeholders: {name} {group_link} {channel_link}
WHAPI_GROUP_INVITE_FALLBACK_TEXT=Hi {name},\n\nWelcome inside The Syndicate.\nJoin our private group here:\n{group_link}\n\nFollow the channel here:\n{channel_link}\n\nWith Honour\nThe Syndicate
