# Sub-agent B — copy these into the bot root .env / Railway variables

# Channel ID (ends with @newsletter). List via GET /admin/channels on the bot.
WHAPI_CHANNEL_ID=

# Content plan tab (same spreadsheet as Leads unless you override sheet id)
GOOGLE_SHEET_CONTENT_WORKSHEET=ContentCalendar

# When date+time in the sheet are interpreted
CONTENT_TIMEZONE=Asia/Karachi

# true = process due pending rows; false = pause Agent B without deleting config
CONTENT_POSTER_ENABLED=true

# Max rows to post per cron tick (keeps one run short)
CONTENT_POSTER_MAX_PER_RUN=5

# Seconds to wait between posts (Whapi rate safety)
CONTENT_POSTER_DELAY_SECONDS=2

# Same CRON_SECRET / WEBHOOK_SECRET as booking reminders
# CRON_SECRET=
